          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Exactly one ring creation succeeds">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">synchronized (props) {
	def successCount = (props.get(&apos;ringRaceSuccessCount&apos;) ?: &apos;0&apos;) as int;
	def conflictCount = (props.get(&apos;ringRaceConflictCount&apos;) ?: &apos;0&apos;) as int;
	if (prev.getResponseCode() == &apos;200&apos;) {
		successCount++;
		props.put(&apos;ringRaceSuccessCount&apos;, successCount.toString());
	} else if (prev.getResponseCode() == &apos;409&apos;) {
		conflictCount++;
		props.put(&apos;ringRaceConflictCount&apos;, conflictCount.toString());
	}
	if (successCount + conflictCount == 2 &amp;&amp; (successCount != 1 || conflictCount != 1)) {
		prev.setSuccessful(false);
		prev.setResponseMessage(&apos;Expected exactly one successful creation and one uniqueness conflict&apos;);
	}
}</stringProp>
