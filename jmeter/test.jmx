        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Choose administrator and operation">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">if (ctx.getThreadNum() == 0) {
	vars.put(&apos;login&apos;, props.get(&apos;adminA&apos;));
	vars.put(&apos;password&apos;, props.get(&apos;adminAPassword&apos;));
	vars.put(&apos;method&apos;, &apos;PUT&apos;);
	vars.put(&apos;body&apos;, &apos;{&quot;name&quot;:&quot;&apos; + props.get(&apos;sharedRingName&apos;) + &apos;&quot;,&quot;power&quot;:99,&quot;weight&quot;:9}&apos;);
} else {
	vars.put(&apos;login&apos;, props.get(&apos;adminB&apos;));
	vars.put(&apos;password&apos;, props.get(&apos;adminBPassword&apos;));
	vars.put(&apos;method&apos;, &apos;DELETE&apos;); vars.put(&apos;body&apos;, &apos;&apos;);
}</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">false</stringProp>
        </JSR223Sampler>
