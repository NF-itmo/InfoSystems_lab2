        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Choose administrator">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">if (ctx.getThreadNum() == 0) {
	vars.put(&apos;login&apos;, props.get(&apos;adminA&apos;));
	vars.put(&apos;password&apos;, props.get(&apos;adminAPassword&apos;));
	props.put(&apos;ringRaceSuccessCount&apos;, &apos;0&apos;);
	props.put(&apos;ringRaceConflictCount&apos;, &apos;0&apos;);
	vars.put(&apos;ringName&apos;, props.get(&apos;uniqueRingNameA&apos;));
} else {
	vars.put(&apos;login&apos;, props.get(&apos;adminB&apos;));
	vars.put(&apos;password&apos;, props.get(&apos;adminBPassword&apos;));
	vars.put(&apos;ringName&apos;, props.get(&apos;uniqueRingNameB&apos;));
}</stringProp>
